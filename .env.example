# Copy to .env and fill in. .env is gitignored and must never be committed.

# Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the CUI's own turns and for grading free-text explanations.
HC_MODEL=claude-sonnet-5

# Model used by the LLM judge in llm_judge/. Kept separate so the judge can be
# swapped without touching the system under test.
HC_JUDGE_MODEL=claude-sonnet-5

# Provider: "anthropic" (default) or "mock".
# "mock" runs the whole interaction with deterministic canned replies so the app
# can be demonstrated without an API key. Mock mode is NOT a substitute for the
# real provider in testing: it bypasses the grading model entirely.
HC_PROVIDER=anthropic

# Port for the web app.
PORT=3000
